Project ecommerce {
  database_type: 'PostgreSQL'
  Note: 'A small e-commerce schema'
}

enum order_status {
  created
  processing
  shipped
  cancelled [note: 'refunded to customer']
}

Table users [headercolor: #2563eb] {
  id int [pk, increment]
  email varchar(255) [not null, unique, note: 'login identifier']
  name varchar(255)
  created_at timestamp [default: `now()`]
  Note: 'registered customers'
}

Table orders {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  status order_status [not null, default: 'created']
  total decimal(10,2) [not null]
  indexes {
    (user_id, status) [name: 'idx_user_status']
  }
}

Table order_items {
  id int [pk]
  order_id int [not null, ref: > orders.id]
  product_id int [not null]
  quantity int [not null, default: 1]
}

TableGroup shop [note: 'customer facing'] {
  users
  orders
  order_items
}

Note roadmap {
  '''
  ## TODO
  - add products table
  - add payments
  '''
}
